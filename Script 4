#!/bin/bash
# Script 4: Log File Analyzer
# Author: [Your Name] | Course: Open Source Software
# Purpose: Reads a log file and counts keyword occurrences

# --- Accept log file and keyword as arguments ---
LOGFILE=${1:-"/var/log/messages"}
KEYWORD=${2:-"error"}
COUNT=0

# --- Check if log file exists ---
if [ ! -f "$LOGFILE" ]; then
    echo "Error: File $LOGFILE not found."
    echo "Trying /var/log/syslog instead..."
    # Retry with alternate log file
    LOGFILE="/var/log/syslog"
    if [ ! -f "$LOGFILE" ]; then
        echo "No log file found. Exiting."
        exit 1
    fi
fi

echo "================================"
echo " Log File Analyzer"
echo "================================"
echo "File    : $LOGFILE"
echo "Keyword : $KEYWORD"
echo "--------------------------------"

# --- Read file line by line and count matches ---
while IFS= read -r LINE; do
    if echo "$LINE" | grep -iq "$KEYWORD"; then
        COUNT=$((COUNT + 1))
    fi
done < "$LOGFILE"

echo "Keyword '$KEYWORD' found $COUNT times"
echo "--------------------------------"

# --- Print last 5 matching lines ---
echo "Last 5 matching lines:"
grep -i "$KEYWORD" "$LOGFILE" | tail -5

echo "================================"
